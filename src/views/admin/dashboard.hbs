<div class="admin-wrapper container">
  <!-- Dashboard Header -->
  <div class="dashboard-header">
    <div>
      <h1 class="page-title">Library Administration Dashboard</h1>
      <p class="page-subtitle">Manage inventory, catalog records, and physical shelf assignments.</p>
    </div>
    <div class="dashboard-header-actions">
      <a href="/" target="_blank" class="btn btn-outline" title="Open Public Catalogue in new tab">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        View Public Site
      </a>
      <a href="/admin/books/new" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add New Book
      </a>
    </div>
  </div>

  <!-- Key Metrics Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon-wrap bg-blue-subtle">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
      </div>
      <div class="stat-data">
        <span class="stat-label">Total Books</span>
        <span class="stat-value">{{totalBooks}}</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon-wrap bg-emerald-subtle">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </div>
      <div class="stat-data">
        <span class="stat-label">Active Shelves</span>
        <span class="stat-value">{{totalShelves}}</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon-wrap bg-amber-subtle">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
      </div>
      <div class="stat-data">
        <span class="stat-label">Categories</span>
        <span class="stat-value">{{totalCategories}}</span>
      </div>
    </div>
  </div>

  <!-- Table Filter & Search Controls -->
  <div class="admin-table-card">
    <div class="table-toolbar">
      <form action="/admin/dashboard" method="GET" class="table-search-form" id="adminFilterForm">
        <div class="search-input-group sm">
          <span class="search-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input 
            type="text" 
            name="q" 
            class="form-control" 
            placeholder="Search records..." 
            value="{{query.q}}"
          >
          {{#if query.q}}
            <a href="/admin/dashboard" class="clear-search-btn">&times;</a>
          {{/if}}
        </div>

        <select name="category" class="form-select sm" onchange="document.getElementById('adminFilterForm').submit()">
          <option value="">All Categories</option>
          {{#each categories}}
            <option value="{{this}}" {{#if (eq ../query.category this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>

        <select name="shelfNumber" class="form-select sm" onchange="document.getElementById('adminFilterForm').submit()">
          <option value="">All Shelves</option>
          {{#each shelves}}
            <option value="{{this}}" {{#if (eq ../query.shelfNumber this)}}selected{{/if}}>Shelf: {{this}}</option>
          {{/each}}
        </select>

        <button type="submit" class="btn btn-sm btn-outline">Filter</button>
        {{#if (or query.q query.category query.shelfNumber)}}
          <a href="/admin/dashboard" class="btn btn-sm btn-link">Reset</a>
        {{/if}}
      </form>

      <span class="records-badge">
        Showing {{filteredCount}} of {{totalBooks}}
      </span>
    </div>

    <!-- Inventory Data Table -->
    {{#if books.length}}
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 50px;">#</th>
              <th>Book Name</th>
              <th>Author</th>
              <th>Category</th>
              <th>Library Code</th>
              <th>Shelf Number</th>
              <th>Added</th>
              <th style="text-align: right; width: 140px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each books}}
              <tr>
                <td class="text-muted">{{inc @index}}</td>
                <td>
                  <strong class="book-name-cell">{{bookName}}</strong>
                </td>
                <td class="text-secondary">{{author}}</td>
                <td>
                  <span class="category-tag sm">{{category}}</span>
                </td>
                <td>
                  <span class="code-badge sm">{{libraryCode}}</span>
                </td>
                <td>
                  <span class="shelf-badge-table">Shelf {{shelfNumber}}</span>
                </td>
                <td class="text-muted text-sm">{{formatDate createdAt}}</td>
                <td class="actions-cell">
                  <a href="/admin/books/{{_id}}/edit" class="action-btn edit-btn" title="Edit Book">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    Edit
                  </a>

                  <form action="/admin/books/{{_id}}?_method=DELETE" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete \'{{bookName}}\' (Shelf: {{shelfNumber}}, Code: {{libraryCode}})? This action cannot be undone.');">
                    <button type="submit" class="action-btn delete-btn" title="Delete Book">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state sm">
        <p class="empty-title">No books found in this view</p>
        <p class="empty-desc">Either no books match your filter or no books have been added yet.</p>
        <a href="/admin/books/new" class="btn btn-primary btn-sm">+ Add a New Book</a>
      </div>
    {{/if}}
  </div>
</div>
