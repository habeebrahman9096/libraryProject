<div class="container section-padding-sm">
  {{> admin-nav}}

  <div class="breadcrumb">
    <a href="/admin/dashboard">&larr; Back to Dashboard</a>
    <span>/</span>
    <span>Admin Credentials &amp; Settings</span>
  </div>

  <div class="form-card-container">
    <div class="form-card">
      <div class="form-header">
        <div class="form-header-icon bg-blue-subtle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div>
          <h1 class="form-title">Admin Account Credentials</h1>
          <p class="form-subtitle">Update your username and secure password stored in the <strong>CREDINTIALS</strong> collection.</p>
        </div>
      </div>

      <div style="background-color: var(--shelf-bg); border: 1px solid var(--shelf-border); padding: 0.85rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: var(--shelf-text);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>Credentials are stored securely in the MongoDB <strong>CREDINTIALS</strong> collection with bcrypt password hashing.</span>
      </div>

      <form action="/admin/settings" method="POST" class="book-form">
        <!-- Current Username display -->
        <div class="form-group">
          <label class="form-label">Current Active Username</label>
          <div style="font-weight: 700; font-size: 1.05rem; color: var(--text-main); background-color: var(--bg-subtle); padding: 0.65rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
            {{currentAdminUser}}
          </div>
        </div>

        <div style="padding-top: 0.5rem; border-top: 1px solid var(--border-light); margin-top: 0.5rem;">
          <!-- Current Password Required to Authorize Changes -->
          <div class="form-group">
            <label for="currentPassword" class="form-label required">Current Password</label>
            <input 
              type="password" 
              id="currentPassword" 
              name="currentPassword" 
              class="form-control" 
              placeholder="Enter current password to verify identity" 
              required
            >
            <span class="form-hint">Required to confirm authorization before updating credentials.</span>
          </div>
        </div>

        <div class="form-grid-2" style="margin-top: 0.5rem;">
          <!-- New Username -->
          <div class="form-group">
            <label for="newUsername" class="form-label required">New Username</label>
            <input 
              type="text" 
              id="newUsername" 
              name="newUsername" 
              class="form-control" 
              value="{{currentAdminUser}}" 
              required
            >
            <span class="form-hint">The username you will use to log in.</span>
          </div>

          <!-- New Password -->
          <div class="form-group">
            <label for="newPassword" class="form-label">New Password</label>
            <input 
              type="password" 
              id="newPassword" 
              name="newPassword" 
              class="form-control" 
              placeholder="Leave blank to keep current password"
            >
            <span class="form-hint">Minimum 4 characters. Leave empty to keep existing password.</span>
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword" class="form-label">Confirm New Password</label>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            class="form-control" 
            placeholder="Repeat new password"
          >
        </div>

        <div class="form-actions-bar">
          <a href="/admin/dashboard" class="btn btn-outline">Cancel</a>
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            Save Credentials to Database
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
